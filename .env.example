# Copia este archivo como .env y rellena tus datos reales.
# El .env NO se comparte (está en .gitignore).

CAM_USER=admin
CAM_PASS=TU_CONTRASEÑA_AQUI
CAM_IP=192.168.100.45
CAM_PORT=554
# Ruta RTSP. Para Uniarch/Uniview lo normal es:
#   principal (alta calidad):  /media/video1
#   secundaria (ligera):       /media/video2
# Si no funciona, el script probará rutas comunes automáticamente.
CAM_RTSP_PATH=/media/video1
